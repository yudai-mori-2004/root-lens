    "@react-navigation/native-stack": "7.18.10",
    "@supabase/supabase-js": "^2.110.2",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3",
    "expo": "~57.0.22",
    "expo-asset": "~57.0.17",
    "expo-audio": "~57.0.5",
