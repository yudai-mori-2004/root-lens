{
  "expo": {
    "name": "RootLens",
    "slug": "rootlens",
    "scheme": "io.rootlens.app",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.rootlens.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "カメラで写真や動画を撮影するために使用します",
        "NSMicrophoneUsageDescription": "iPhone撮影モードでは映像とともに現場音声を記録します。また、音声操作を選んだ場合は撮影の開始・終了コマンドの認識にも使用します",
        "NSMotionUsageDescription": "撮影中の端末の動き (加速度・ジャイロ) を記録し、映像との整合性検証に使用します",
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "「さつえいスタート」「さつえいストップ」の音声コマンドを端末内で認識するために使用します。音声が端末の外に送られることはありません"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "io.rootlens.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-dev-client",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "カメラで写真を撮影するために使用します",
          "microphonePermission": "動画撮影で音声を録音するために使用します"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-audio",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "b5defe64-e954-40de-9c64-abdc5e80b9d2"
      }
    }
  }
}
